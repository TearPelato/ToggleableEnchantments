{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/LIUKRAST/ToggleableEnchantments"
    },
    "license": "${license}",
    "icon": "toggleable_enchantments.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.liukrast.toggleable_enchantments.ToggleableEnchantments"
        ],
        "client": [
            "net.liukrast.toggleable_enchantments.ToggleableEnchantments"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_fabric_version_range}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  